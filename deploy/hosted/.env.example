# kaisho-cloud hosted stack — environment.
# Copy to .env next to docker-compose.yml, fill in real
# secrets, and chmod 600. Never commit the filled .env.

# ── Dedicated PostgreSQL (in-stack) ─────────────────────
POSTGRES_DB=kaisho
POSTGRES_USER=kaisho
POSTGRES_PASSWORD=change-me-long-random

# Connection the app + migrate runner use. Host "db" is the
# in-stack postgres service on kaisho-sync-internal. Must
# match the POSTGRES_* values above.
DATABASE_URL=postgres://kaisho:change-me-long-random@db:5432/kaisho

# ── AI gateway ──────────────────────────────────────────
OPENROUTER_API_KEY=sk-or-v1-...
# Optional instance-wide monthly AI token cap per user.
# Unset falls back to the gateway_config row default.
# AI_MONTHLY_TOKEN_CAP=2000000

# ── Integration credential crypto ───────────────────────
# 32-byte hex (openssl rand -hex 32).
INTEGRATION_KEY=
# OAuth state HMAC secret.
INTEGRATION_STATE_SECRET=
# Password-reset token HMAC secret.
RESET_TOKEN_SECRET=

# ── Email (optional; password reset, notifications) ─────
# RESEND_API_KEY=
# EMAIL_FROM=noreply@kaisho.dev

# ── Public base URL ─────────────────────────────────────
BASE_URL=https://cloud.kaisho.dev

# ── Coming with later PRs (self-owned auth + provisioning) ─
# Self-owned JWT signing secret (replaces Supabase Auth).
# JWT_SECRET=
# Admin API key that the private kaisho-billing service uses
# to provision / disable accounts on this instance.
# ADMIN_API_KEY=
# open = anyone can sign up (self-host default);
# token = signups only via the admin provisioning API
#         (our managed instance runs closed).
# SIGNUP_MODE=token

# ── Legacy (still required until the pg data layer lands) ─
# The app currently reads/writes via Supabase; these stay
# mandatory until that swap ships, after which they go away.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGc...

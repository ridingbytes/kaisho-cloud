# kaisho-cloud hosted stack — environment.
# Copy to .env next to docker-compose.yml, fill in real
# secrets, and chmod 600. Never commit the filled .env.

# ── Dedicated PostgreSQL (in-stack) ─────────────────────
POSTGRES_DB=kaisho
POSTGRES_USER=kaisho
POSTGRES_PASSWORD=change-me-long-random

# Connection the app + migrate runner use. Host "db" is the
# in-stack postgres service on internal. Must
# match the POSTGRES_* values above.
DATABASE_URL=postgres://kaisho:change-me-long-random@db:5432/kaisho

# ── AI gateway ──────────────────────────────────────────
OPENROUTER_API_KEY=sk-or-v1-...
# Optional instance-wide monthly AI token cap per user.
# Unset falls back to the gateway_config row default.
# AI_MONTHLY_TOKEN_CAP=2000000

# ── Integration credential crypto ───────────────────────
# 32-byte hex (openssl rand -hex 32).
INTEGRATION_KEY=
# OAuth state HMAC secret.
INTEGRATION_STATE_SECRET=
# Password-reset token HMAC secret.
RESET_TOKEN_SECRET=

# ── Email (optional; password reset, notifications) ─────
# RESEND_API_KEY=
# EMAIL_FROM=noreply@kaisho.dev

# ── Hosted MCP gateway ──────────────────────────────────
# Mounts the MCP server at POST /mcp when "true". Our
# managed instance runs it; a deployment that leaves this
# unset does not expose the endpoint at all.
MCP_GATEWAY_ENABLED=true

# ── Integration OAuth clients ───────────────────────────
# Each pair is needed only for that provider. Linear and
# GitHub connect with a pasted token instead and need
# nothing here.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Public base URL ─────────────────────────────────────
BASE_URL=https://cloud.kaisho.dev
# Port inside the container; Traefik routes to it.
PORT=3000

# ── Self-owned auth + provisioning ──────────────────────
# Set a long random JWT signing secret.
JWT_SECRET=change-me-long-random
# Our managed instance runs closed: accounts are created only
# by the billing service via the admin API, not public signup.
SIGNUP_MODE=token
# Shared bearer key the private kaisho-billing service uses to
# provision / disable / rotate accounts at POST /admin/accounts.
ADMIN_API_KEY=change-me-long-random

# NOTE: no billing keys here — billing lives in the separate
# private kaisho-billing service.

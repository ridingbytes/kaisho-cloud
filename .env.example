# ── PostgreSQL ──────────────────────────────────────────
# The only backend. This is what the docker-compose.yml
# self-host stack uses.

# Postgres credentials. In docker-compose these create the db
# container AND must match DATABASE_URL below (host is "db",
# the compose service name). For a non-compose Postgres, set
# DATABASE_URL to point at it and ignore POSTGRES_*.
POSTGRES_DB=kaisho
POSTGRES_USER=kaisho
POSTGRES_PASSWORD=change-me-please
DATABASE_URL=postgres://kaisho:change-me-please@db:5432/kaisho

# Secret used to sign/verify access + refresh JWTs. REQUIRED in
# postgres mode. Use a long random value, e.g. openssl rand -hex 32.
JWT_SECRET=change-me-long-random
# Token lifetimes (optional; defaults shown).
# JWT_ACCESS_TTL=1h
# JWT_REFRESH_TTL=30d

# Public signup mode:
#   open  - anyone may POST /auth/signup (self-host default)
#   token - signups closed; accounts come only from the admin
#           provisioning API (used by our managed instance).
SIGNUP_MODE=open

# Admin provisioning API (optional). Shared bearer key for
# POST /admin/accounts. Leave unset unless you run a billing
# front-end that provisions accounts. Not needed for self-host.
# ADMIN_API_KEY=

# ── Email (optional; welcome + password reset) ──────────
# Without RESEND_API_KEY, emails become no-ops (the server
# still boots). Paid billing lives in the separate, private
# kaisho-billing service, not here.
# RESEND_API_KEY=re_...
# EMAIL_FROM=Kaisho <noreply@kaisho.dev>

# ── Password reset (REQUIRED for /auth/forgot-password) ─
# HMAC secret for signed reset tokens. Without this set,
# /auth/forgot-password and /auth/reset-password return
# 503. Generate with: openssl rand -hex 32
RESET_TOKEN_SECRET=

# ── AI gateway ──────────────────────────────────────────
# Default backend is OpenRouter. Get a key at
# https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# Optional instance-wide monthly AI token cap per user.
# There are no plans: every account shares this cap. Unset
# falls back to gateway_config.monthly_token_cap in the DB.
# A per-user users.monthly_token_cap_override still wins.
# AI_MONTHLY_TOKEN_CAP=2000000

# Optional model overrides — defaults shown.
# AI_MODEL_FAST=google/gemini-2.0-flash-lite-001
# AI_MODEL_DEFAULT=anthropic/claude-sonnet-4
# AI_MODEL_ADVISOR=anthropic/claude-haiku-4.5
# AI_MODEL_CRON=google/gemma-4-31b-it
# AI_MODEL_KAISHO_DEFAULT=anthropic/claude-haiku-4.5

# Comma-separated allowlist of models the gateway will
# accept. Defaults to a hardcoded set in api/ai/engine.js;
# override only when adding a new provider/model the code
# does not yet know about.
# AI_ALLOWED_MODELS=anthropic/claude-haiku-4.5,...

# Concurrency cap for outbound model calls. Defaults to a
# value baked into api/ai/queue.js. Raise only if your
# backend can absorb the burst.
# AI_MAX_CONCURRENCY=

# Override the default backend (OpenRouter) — uncommon.
# BACKEND_URL is the chat-completions endpoint;
# BACKEND_API_KEY_ENV is the name of the env var holding
# the key (must be in api/ai/engine.js
# ALLOWED_BACKEND_KEY_ENVS); BACKEND_LABEL is the label
# emitted in logs.
# BACKEND_URL=https://openrouter.ai/api/v1/chat/completions
# BACKEND_API_KEY_ENV=OPENROUTER_API_KEY
# BACKEND_LABEL=openrouter

# ── MCP gateway ─────────────────────────────────────────
# Mounts the hosted MCP server at POST /mcp when set to
# "true". Disabled by default so a deployment that does not
# want it does not expose the endpoint at all.
MCP_GATEWAY_ENABLED=false

# ── Workspace integrations ──────────────────────────────
# AES-256-GCM key for encrypting third-party integration
# credentials at rest. 32 bytes, hex — generate with:
#   openssl rand -hex 32
# Required only when integrations are configured; the API
# boots without it.
INTEGRATION_KEY=

# Dedicated HMAC secret for OAuth state tokens. Separate
# from INTEGRATION_KEY so the AES key and the signing key
# are not the same value (defence-in-depth). When unset,
# the code falls back to INTEGRATION_KEY for backwards
# compatibility. Generate with: openssl rand -hex 32
INTEGRATION_STATE_SECRET=

# OAuth client credentials per provider. Each pair is
# required only when that integration is enabled.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── App ─────────────────────────────────────────────────
BASE_URL=https://cloud.kaisho.dev
PORT=3000

# ── Licence (AGPL-3.0 section 13) ───────────────────────
# GET / offers the source of the running instance. If you
# run a MODIFIED build as a network service, point this at
# your own repository: offering our source for your code
# does not satisfy the licence. Unmodified self-hosting can
# leave it unset.
# SOURCE_URL=https://github.com/you/kaisho-cloud


# ── Supabase (REQUIRED) ─────────────────────────────────
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGc...

# ── Billing switch ──────────────────────────────────────
# Paid plans are closed for the open-source transition.
# Leave unset (or not "true") to refuse new checkout and
# token-pack purchases. Existing subscriptions, the customer
# portal, and the Stripe webhook keep working.
# BILLING_ENABLED=true

# ── Stripe (REQUIRED for billing) ───────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Track AI plan price IDs (run scripts/create-stripe-products.js
# once per Stripe mode to generate these; the script prints the
# block ready to paste).
STRIPE_PRICE_COMPANION_MONTHLY=price_...
STRIPE_PRICE_COMPANION_YEARLY=price_...
STRIPE_PRICE_PRO_MONTHLY=price_...
STRIPE_PRICE_PRO_YEARLY=price_...
STRIPE_PRICE_TEAM_MONTHLY=price_...
STRIPE_PRICE_TEAM_YEARLY=price_...
STRIPE_PRICE_TOKEN_PACK_500K=price_...

# ── Apple App Store (iOS in-app purchases) ──────────────
# iOS-only. The web PWA stays Stripe-only; these are used
# solely to verify StoreKit 2 transactions the iOS app
# sends to POST /billing/apple/verify. See docs/apple-iap.md.

# The app's bundle id. A signed transaction whose bundleId
# does not match is rejected. Defaults to dev.kaisho.app.
# APPLE_BUNDLE_ID=dev.kaisho.app

# Accepted StoreKit environment(s), comma-separated. Prod
# builds see "Production"; Sandbox testers and App Review
# see "Sandbox". Set "Production,Sandbox" during review.
# APPLE_ENVIRONMENT=Production

# App Store Connect product ids → Companion plan. Defaults
# match the ids the iOS app ships with; override only if the
# products are named differently in App Store Connect.
# APPLE_PRODUCT_COMPANION_MONTHLY=dev.kaisho.app.companion.monthly
# APPLE_PRODUCT_COMPANION_YEARLY=dev.kaisho.app.companion.yearly

# Directory holding Apple's root CA (used to verify the
# StoreKit JWS signature chain). Download AppleRootCA-G3.cer
# from https://www.apple.com/certificateauthority/ and drop
# it here. Defaults to api/billing/apple/certs/. Without a
# root cert, POST /billing/apple/verify returns 503.
# APPLE_ROOT_CA_PATH=api/billing/apple/certs

# App Store Server Notifications V2 are delivered to
# POST /billing/apple/notifications and verified by their JWS
# signature — no shared secret needed. Point the "Production"
# and "Sandbox" Server URLs in App Store Connect at that path.

# App Store Server API credentials. Only needed for
# server-initiated calls (subscription status lookups,
# notification-history replay); the verify + notification
# endpoints above do NOT require them. Provision an API key
# in App Store Connect → Users and Access → Integrations.
# APPLE_ASC_ISSUER_ID=
# APPLE_ASC_KEY_ID=
# The .p8 private key, either as a path or inline PEM.
# APPLE_ASC_PRIVATE_KEY_PATH=

# ── Email (REQUIRED for signup / password reset) ────────
RESEND_API_KEY=re_...
EMAIL_FROM=Kaisho <noreply@kaisho.dev>

# ── Password reset (REQUIRED for /auth/forgot-password) ─
# HMAC secret for signed reset tokens. Without this set,
# /auth/forgot-password and /auth/reset-password return
# 503. Generate with: openssl rand -hex 32
RESET_TOKEN_SECRET=

# ── AI gateway (REQUIRED for paid plans) ────────────────
# Default backend is OpenRouter. Get a key at
# https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# Optional model overrides — defaults shown.
# AI_MODEL_FAST=google/gemini-2.0-flash-lite-001
# AI_MODEL_DEFAULT=anthropic/claude-sonnet-4
# AI_MODEL_ADVISOR=anthropic/claude-haiku-4.5
# AI_MODEL_CRON=google/gemma-4-31b-it
# AI_MODEL_KAISHO_DEFAULT=anthropic/claude-haiku-4.5

# Comma-separated allowlist of models the gateway will
# accept. Defaults to a hardcoded set in api/ai/engine.js;
# override only when adding a new provider/model the code
# does not yet know about.
# AI_ALLOWED_MODELS=anthropic/claude-haiku-4.5,...

# Concurrency cap for outbound model calls. Defaults to a
# value baked into api/ai/queue.js. Raise only if your
# backend can absorb the burst.
# AI_MAX_CONCURRENCY=

# Override the default backend (OpenRouter) — uncommon.
# BACKEND_URL is the chat-completions endpoint;
# BACKEND_API_KEY_ENV is the name of the env var holding
# the key (must be in api/ai/engine.js
# ALLOWED_BACKEND_KEY_ENVS); BACKEND_LABEL is the label
# emitted in logs.
# BACKEND_URL=https://openrouter.ai/api/v1/chat/completions
# BACKEND_API_KEY_ENV=OPENROUTER_API_KEY
# BACKEND_LABEL=openrouter

# ── MCP gateway (Companion+ feature) ────────────────────
# Mounts the hosted MCP server at POST /mcp when set to
# "true". Disabled by default so deployments without the
# feature flag don't expose the endpoint.
MCP_GATEWAY_ENABLED=false

# ── Premium integrations (Pro tier) ─────────────────────
# AES-256-GCM key for encrypting third-party integration
# credentials at rest. 32 bytes, hex — generate with:
#   openssl rand -hex 32
# Required only when premium integrations are configured;
# the API boots without it.
INTEGRATION_KEY=

# Dedicated HMAC secret for OAuth state tokens. Separate
# from INTEGRATION_KEY so the AES key and the signing key
# are not the same value (defence-in-depth). When unset,
# the code falls back to INTEGRATION_KEY for backwards
# compatibility. Generate with: openssl rand -hex 32
INTEGRATION_STATE_SECRET=

# OAuth client credentials per provider. Each pair is
# required only when that integration is enabled.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── App ─────────────────────────────────────────────────
BASE_URL=https://cloud.kaisho.dev
PORT=3000

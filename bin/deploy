#!/usr/bin/env bash
# Ship kaisho-cloud to the VPS over SSH and build it there.
#
# There is no registry and no CI in this path. The repo is
# the source of truth, the VPS is a mirror: rsync the work
# tree into ${REMOTE_DIR}/src, build the image on the host,
# run the migrations, recreate the containers.
#
# Building on the VPS rather than locally avoids emulating
# linux/amd64 on an arm64 Mac and keeps the deploy to one
# rsync plus a build. The cost is that the source lives on
# the server; ${REMOTE_DIR}/src is therefore a throwaway
# mirror, never edited by hand (bin/deploy --check tells you
# when someone did anyway).
#
# Usage:
#   bin/deploy              build + migrate + restart
#   bin/deploy --dry-run    show what would ship, change
#                           nothing
#   bin/deploy --check      diff the VPS mirror against the
#                           work tree and exit
#   bin/deploy --no-test    skip the local test run (only
#                           when tests are known green)
#
# Environment:
#   REMOTE            ssh alias. Default: vps
#   REMOTE_DIR        stack directory on the VPS.
#                     Default: /home/docker/kaisho-cloud
#   HEALTH_URL        URL to probe after the restart.
#                     Default: https://cloud.kaisho.dev/healthz
#   DEPLOY_CONFIRM    set to "deploy" to skip the prompt
#
# Rollback: there is no image to re-pin, so roll back the
# way you rolled forward: check out the previous commit
# (.deploy-sha.prev on the VPS names it) and run bin/deploy
# again.
set -euo pipefail

# $0 is relative when invoked as bin/deploy, so
# resolve it before the cd makes it unusable.
self="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"
cd "$(dirname "$0")/.."

REMOTE="${REMOTE:-vps}"
REMOTE_DIR="${REMOTE_DIR:-/home/docker/kaisho-cloud}"
# Who owns the stack on the host. We connect as root; every
# file we leave behind belongs to this user.
REMOTE_USER="${REMOTE_USER:-docker}"
HEALTH_URL="${HEALTH_URL:-https://cloud.kaisho.dev/healthz}"

dry=0
check_only=0
run_tests=1
for arg in "$@"; do
    case "${arg}" in
        --dry-run) dry=1 ;;
        --check)   check_only=1 ;;
        --no-test) run_tests=0 ;;
        -h|--help)
            sed -n '2,35p' "${self}" \
                | sed 's/^#\{0,1\} \{0,1\}//'
            exit 0 ;;
        *) echo "unknown arg: ${arg}" >&2; exit 2 ;;
    esac
done

# --chown, because we connect as root: without it rsync -a
# writes the workstation's uid (501:staff on macOS) onto
# every file, leaving the host owning files as a user that
# does not exist there. The stack runs as docker.
rsync_chown=(--chown=docker:docker)

# Everything the image does not need, plus everything that
# must never leave the workstation (.env) or be overwritten
# on the host. mobile/dist is built inside the Dockerfile,
# so the local copy would only shadow a fresh build.
rsync_excludes=(
    --exclude='.git'
    --exclude='.github'
    --exclude='.claude'
    --exclude='node_modules'
    --exclude='mobile/node_modules'
    --exclude='mobile/dist'
    --exclude='.env'
    --exclude='.env.*'
    --exclude='.DS_Store'
    --exclude='*.log'
    --exclude='supabase/.temp'
)

sha="$(git rev-parse --short HEAD)"
# --show-current, not rev-parse --abbrev-ref: the latter
# returns the string "HEAD" on a detached checkout, and
# "origin/HEAD" resolves to the default branch, so the
# push check below could pass while comparing something
# else entirely.
branch="$(git branch --show-current)"
if [[ -z "${branch}" ]]; then
    echo "detached HEAD; check out a branch first" >&2
    exit 1
fi
dirty=""
[[ -n "$(git status --porcelain)" ]] && dirty=" (dirty)"

echo "repo:    ${branch} @ ${sha}${dirty}"
echo "target:  ${REMOTE}:${REMOTE_DIR}"
echo "health:  ${HEALTH_URL}"
echo

# --- Drift check -------------------------------------------
# --delete is part of the real sync, so an --itemize-changes
# dry run is also the honest answer to "does the host still
# match the repo".
if [[ "${check_only}" -eq 1 ]]; then
    # -a, not -r: the real sync preserves permissions, times
    # and symlinks, so a check that drops them reports "in
    # sync" for a file that was chmod-ed or replaced by a
    # link on the host.
    echo "==> comparing ${REMOTE_DIR}/src against the work tree"
    out="$(rsync -an --checksum --delete --itemize-changes \
        "${rsync_chown[@]}" "${rsync_excludes[@]}" \
        ./ "${REMOTE}:${REMOTE_DIR}/src/")"
    if [[ -z "${out}" ]]; then
        echo "in sync"
    else
        echo "${out}"
    fi

    # The compose file is the one this script tells people not
    # to edit on the host, so it is the one worth checking.
    echo "==> comparing ${REMOTE_DIR}/docker-compose.yml"
    if ssh "${REMOTE}" "cat ${REMOTE_DIR}/docker-compose.yml" \
            2>/dev/null | diff -q - deploy/hosted/docker-compose.yml \
            >/dev/null; then
        echo "in sync"
    else
        ssh "${REMOTE}" "cat ${REMOTE_DIR}/docker-compose.yml" \
            2>/dev/null \
            | diff -u - deploy/hosted/docker-compose.yml || true
    fi
    exit 0
fi

# --- Preflight ---------------------------------------------
# Both of these are refusals rather than warnings, because
# what they protect is .deploy-sha: the file that answers
# "what is running". A dirty tree ships content no commit
# describes, an unpushed HEAD names a commit nobody else can
# resolve, and either way the recorded sha is a lie: which
# takes the documented rollback with it.
if [[ -n "${dirty}" ]]; then
    echo "working tree is dirty; commit or stash first:" >&2
    git status --short >&2
    exit 1
fi

git fetch -q origin
if [[ "$(git rev-parse HEAD)" != \
      "$(git rev-parse "origin/${branch}" 2>/dev/null)" ]]; then
    echo "HEAD differs from origin/${branch}; push first" >&2
    exit 1
fi

if [[ "${run_tests}" -eq 1 && "${dry}" -eq 0 ]]; then
    echo "==> running tests"
    pnpm test
    echo
fi

# --- Confirmation ------------------------------------------
if [[ "${dry}" -eq 0 ]]; then
    answer="${DEPLOY_CONFIRM:-}"
    if [[ -z "${answer}" ]]; then
        read -rp 'Type "deploy" to ship to production: ' answer
    fi
    if [[ "${answer}" != "deploy" ]]; then
        echo "Aborted."
        exit 1
    fi
    echo
fi

# --- Ship the stack files ----------------------------------
# The compose file and the Traefik route live in the repo;
# the .env lives only on the host. deploy/hosted is the
# hosted stack's definition, docker-compose.yml at the repo
# root is the self-host one and must not be shipped.
echo "==> syncing source"
rsync_opts=(-az --delete "${rsync_chown[@]}" "${rsync_excludes[@]}")
[[ "${dry}" -eq 1 ]] && rsync_opts+=(-nv --itemize-changes)
rsync "${rsync_opts[@]}" ./ "${REMOTE}:${REMOTE_DIR}/src/"

echo "==> syncing compose file + backup script"
compose_opts=(-az "${rsync_chown[@]}")
[[ "${dry}" -eq 1 ]] && compose_opts+=(-nv --itemize-changes)
rsync "${compose_opts[@]}" deploy/hosted/docker-compose.yml \
    "${REMOTE}:${REMOTE_DIR}/docker-compose.yml"
rsync "${compose_opts[@]}" deploy/hosted/backup \
    "${REMOTE}:${REMOTE_DIR}/backup"

if [[ "${dry}" -eq 1 ]]; then
    echo "==> dry run; not building, migrating or restarting"
    exit 0
fi

# --- Build, migrate, restart -------------------------------
# db first, then migrate to completion, then the app. The
# final up uses --no-deps: api depends_on migrate
# (service_completed_successfully), which is what a
# self-hoster's `docker compose up` needs, but here migrate
# has just run and --no-deps keeps it from running twice.
# db/migrate.js is idempotent either way, so a no-op deploy
# is cheap.
echo "==> building on the host"
ssh "${REMOTE}" "cd ${REMOTE_DIR} && docker compose build"

echo "==> starting db"
ssh "${REMOTE}" "cd ${REMOTE_DIR} && docker compose up -d db"

echo "==> migrating"
ssh "${REMOTE}" "cd ${REMOTE_DIR} && docker compose run --rm migrate"

# Every service except migrate, derived from the compose
# file rather than listed here. The list used to be a literal
# "api cron", so adding pgweb deployed its definition and
# never started it: the deploy reported success while the new
# container did not exist. A service added tomorrow would
# have gone the same way.
#
# migrate is excluded because it has just run above;
# --no-deps then keeps compose from pulling it back in.
echo "==> restarting services"
# The service list is substituted remotely and left unquoted
# so the shell splits it into arguments. An earlier attempt
# built it into a variable first and passed "$services",
# which reached docker as the single argument
# "db api cron pgweb" and failed with "no such service".
ssh "${REMOTE}" "
    cd ${REMOTE_DIR}
    docker compose config --services | grep -vx migrate \
        | sed 's/^/    /'
    docker compose up -d --no-deps \
        \$(docker compose config --services | grep -vx migrate)
"

# --- Health ------------------------------------------------
# Before recording anything. A failed deploy that has already
# written .deploy-sha claims a version that is not serving,
# and has overwritten .deploy-sha.prev: the one value the
# documented rollback needs: with the version that just
# failed. Two bad deploys in a row and the last good sha is
# gone entirely.
echo "==> waiting for health (up to 60s)"
healthy=0
for i in $(seq 1 30); do
    if curl -fsS --max-time 5 "${HEALTH_URL}" >/dev/null 2>&1; then
        echo "==> endpoint up on attempt ${i}"
        healthy=1
        break
    fi
    sleep 2
done

if [[ "${healthy}" -eq 0 ]]; then
    echo "ERROR: ${HEALTH_URL} did not come up within 60s" >&2
    echo "(.deploy-sha left untouched; it still names the" >&2
    echo " previous deploy)" >&2
    ssh "${REMOTE}" "docker logs kaisho-cloud --tail 40" >&2
    exit 1
fi

# The endpoint answering only proves something is listening.
# bin/health also checks the cron worker and the database, so
# a deploy where api is up but cron is crash-looping fails
# here instead of printing success.
echo "==> full health check"
if ! REMOTE="${REMOTE}" REMOTE_DIR="${REMOTE_DIR}" \
        HEALTH_URL="${HEALTH_URL}" HEALTH_SKIP_REVISION=1 \
        ./bin/health; then
    echo "ERROR: the stack is not healthy after deploy" >&2
    echo "(.deploy-sha left untouched)" >&2
    exit 1
fi

# --- Record what shipped -----------------------------------
# .deploy-sha.prev only exists from the second deploy on, so
# chown takes the files that are actually there. Getting this
# wrong failed the whole script on a fresh host, after a
# deploy that had in fact succeeded.
ssh "${REMOTE}" "
    cd ${REMOTE_DIR}
    [[ -f .deploy-sha ]] && cp .deploy-sha .deploy-sha.prev
    echo '${sha}' > .deploy-sha
    chown ${REMOTE_USER}:${REMOTE_USER} .deploy-sha
    [[ -f .deploy-sha.prev ]] \
        && chown ${REMOTE_USER}:${REMOTE_USER} .deploy-sha.prev
    true
"

echo "==> deployed ${sha}"

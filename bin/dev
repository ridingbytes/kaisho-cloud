#!/usr/bin/env bash
# Run the Kaisho Cloud sync server locally for testing.
#
# Usage:
#   bin/dev              Start API on :3030 (PWA served at /m/)
#   bin/dev --mobile     Also start Vite dev server on :5174
#                        (hot reload for mobile PWA)
#   bin/dev --rebuild    Rebuild mobile PWA before starting
#   bin/dev --kill       Kill any stale Kaisho server on the
#                        port without prompting first
#   PORT=4000 bin/dev    Override API port
#
# Env:
#   BIN_DEV_KILL=1       Same as --kill, useful in scripts.
#
# Default port is 3030 (not 3000) to avoid colliding with
# the kaisho-website dev server.
#
# Prereqs:
#   .env must exist (copy from .env.example and fill in
#   Supabase/Stripe/Resend keys).
#
# Point your local kaisho app's cloud-sync URL at
# http://localhost:3030 to test sync end-to-end.

set -euo pipefail

DIR="$(cd "$(dirname "$0")/.." && pwd)"
cd "$DIR"

WITH_MOBILE=0
REBUILD=0
KILL_STALE="${BIN_DEV_KILL:-0}"
for arg in "$@"; do
  case "$arg" in
    --mobile)  WITH_MOBILE=1 ;;
    --rebuild) REBUILD=1 ;;
    --kill)    KILL_STALE=1 ;;
    -h|--help)
      awk '/^#!/ {next} /^#/ {sub(/^# ?/, ""); print; next}
           {exit}' "$0"
      exit 0
      ;;
    *)
      echo "Unknown flag: $arg" >&2
      exit 2
      ;;
  esac
done

# -- .env --

if [ ! -f .env ]; then
  echo "No .env found." >&2
  if [ -f .env.example ]; then
    echo "Copy .env.example to .env and fill in secrets:" >&2
    echo "  cp .env.example .env" >&2
  fi
  exit 1
fi

# -- Dependencies --

if [ ! -d node_modules ]; then
  echo "Installing API dependencies..."
  pnpm install
fi

if [ ! -d mobile/node_modules ]; then
  echo "Installing mobile dependencies..."
  (cd mobile && pnpm install)
fi

if [ "$REBUILD" = "1" ] || [ ! -d mobile/dist/assets ]; then
  echo "Building mobile PWA..."
  (cd mobile && pnpm build)
fi

# -- Child processes --

pids=()
cleanup() {
  for pid in "${pids[@]:-}"; do
    kill "$pid" 2>/dev/null || true
  done
}
trap cleanup EXIT INT TERM

if [ "$WITH_MOBILE" = "1" ]; then
  echo "Starting mobile Vite dev server on :5174..."
  (cd mobile && pnpm dev) &
  pids+=("$!")
fi

# -- API --

PORT="${PORT:-3030}"
export PORT

# Detect a stale Kaisho server on $PORT (typical when a
# previous bin/dev was backgrounded, lost its parent, or
# crashed without releasing the port). Auto-kill only when
# we recognize the holder as one of our own
# (node api/server.js) -- never kill an unknown process.
preflight_port() {
  local pids
  pids=$(lsof -ti :"$PORT" 2>/dev/null || true)
  [ -z "$pids" ] && return 0

  local own=""
  for pid in $pids; do
    local cmd
    cmd=$(ps -p "$pid" -o command= 2>/dev/null || true)
    if echo "$cmd" | grep -qE "node.*api/server\.js"; then
      own="$own $pid"
    fi
  done
  own=$(echo "$own" | xargs)

  if [ -z "$own" ]; then
    echo "Port $PORT is in use by an unknown process:" >&2
    lsof -i :"$PORT" 2>/dev/null | head -3 >&2
    echo "Refusing to touch it. Free the port manually, " \
         "or run with a different PORT=" >&2
    exit 1
  fi

  echo "Port $PORT is held by a stale Kaisho server " \
       "(PID(s): $own)." >&2

  if [ "$KILL_STALE" = "1" ]; then
    echo "  --kill / BIN_DEV_KILL set, killing..." >&2
  elif [ -t 0 ]; then
    printf "  Kill it and continue? [Y/n] " >&2
    local reply
    read -r reply
    case "$reply" in
      ""|y|Y|yes|YES) ;;
      *) echo "Aborted." >&2; exit 1 ;;
    esac
  else
    echo "  Non-interactive shell, refusing to kill." >&2
    echo "  Re-run with --kill or set BIN_DEV_KILL=1." >&2
    exit 1
  fi

  # shellcheck disable=SC2086
  kill $own 2>/dev/null || true
  sleep 1

  # Force-kill any survivors that ignored SIGTERM.
  local survivors
  survivors=$(lsof -ti :"$PORT" 2>/dev/null || true)
  if [ -n "$survivors" ]; then
    echo "  Force-killing $survivors..." >&2
    # shellcheck disable=SC2086
    kill -9 $survivors 2>/dev/null || true
    sleep 1
  fi

  if [ -n "$(lsof -ti :"$PORT" 2>/dev/null || true)" ]; then
    echo "Port $PORT still busy after kill attempts." >&2
    exit 1
  fi
}

preflight_port

echo
echo "Kaisho Cloud (local)"
echo "  API:           http://localhost:$PORT"
echo "  Mobile PWA:    http://localhost:$PORT/m/"
if [ "$WITH_MOBILE" = "1" ]; then
  echo "  Mobile (Vite): http://localhost:5174/m/"
fi
echo "  Health:        http://localhost:$PORT/health"
echo

exec node --env-file=.env api/server.js

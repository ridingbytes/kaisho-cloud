#!/usr/bin/env bash
# Run the Kaisho Cloud sync server locally for testing.
#
# Usage:
#   bin/dev              Start API on :3030 (PWA served at /m/)
#   bin/dev --mobile     Also start Vite dev server on :5174
#                        (hot reload for mobile PWA)
#   bin/dev --rebuild    Rebuild mobile PWA before starting
#   PORT=4000 bin/dev    Override API port
#
# Default port is 3030 (not 3000) to avoid colliding with
# the kaisho-website dev server.
#
# Prereqs:
#   .env must exist (copy from .env.example and fill in
#   Supabase/Stripe/Resend keys).
#
# Point your local kaisho app's cloud-sync URL at
# http://localhost:3030 to test sync end-to-end.

set -euo pipefail

DIR="$(cd "$(dirname "$0")/.." && pwd)"
cd "$DIR"

WITH_MOBILE=0
REBUILD=0
for arg in "$@"; do
  case "$arg" in
    --mobile)  WITH_MOBILE=1 ;;
    --rebuild) REBUILD=1 ;;
    -h|--help)
      awk '/^#!/ {next} /^#/ {sub(/^# ?/, ""); print; next}
           {exit}' "$0"
      exit 0
      ;;
    *)
      echo "Unknown flag: $arg" >&2
      exit 2
      ;;
  esac
done

# -- .env --

if [ ! -f .env ]; then
  echo "No .env found." >&2
  if [ -f .env.example ]; then
    echo "Copy .env.example to .env and fill in secrets:" >&2
    echo "  cp .env.example .env" >&2
  fi
  exit 1
fi

# -- Dependencies --

if [ ! -d node_modules ]; then
  echo "Installing API dependencies..."
  pnpm install
fi

if [ ! -d mobile/node_modules ]; then
  echo "Installing mobile dependencies..."
  (cd mobile && pnpm install)
fi

if [ "$REBUILD" = "1" ] || [ ! -d mobile/dist/assets ]; then
  echo "Building mobile PWA..."
  (cd mobile && pnpm build)
fi

# -- Child processes --

pids=()
cleanup() {
  for pid in "${pids[@]:-}"; do
    kill "$pid" 2>/dev/null || true
  done
}
trap cleanup EXIT INT TERM

if [ "$WITH_MOBILE" = "1" ]; then
  echo "Starting mobile Vite dev server on :5174..."
  (cd mobile && pnpm dev) &
  pids+=("$!")
fi

# -- API --

PORT="${PORT:-3030}"
export PORT

echo
echo "Kaisho Cloud (local)"
echo "  API:           http://localhost:$PORT"
echo "  Mobile PWA:    http://localhost:$PORT/m/"
if [ "$WITH_MOBILE" = "1" ]; then
  echo "  Mobile (Vite): http://localhost:5174/m/"
fi
echo "  Health:        http://localhost:$PORT/health"
echo

exec node --env-file=.env api/server.js

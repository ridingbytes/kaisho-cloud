#!/usr/bin/env bash
# Tail the hosted stack's logs on the VPS.
#
# Usage:
#   bin/logs                 # follow the API
#   bin/logs cron            # follow the cron worker
#   bin/logs db              # follow Postgres
#   bin/logs --tail 200      # docker logs flags pass through
#   bin/logs cron --since 1h
#
# Environment:
#   REMOTE   ssh alias. Default: vps
set -euo pipefail

REMOTE="${REMOTE:-vps}"

container="kaisho-sync"
case "${1:-}" in
    api)  shift ;;
    cron) container="kaisho-sync-cron"; shift ;;
    db)   container="kaisho-sync-db";   shift ;;
esac

if [[ "$#" -eq 0 ]]; then
    exec ssh "${REMOTE}" "docker logs -f ${container}"
fi

exec ssh "${REMOTE}" "docker logs $* ${container}"

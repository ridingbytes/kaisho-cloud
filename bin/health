#!/usr/bin/env bash
# Health check for the hosted stack on the VPS. Exits
# non-zero if any check fails. Safe to call from cron or an
# uptime monitor.
#
# Usage:
#   bin/health
#
# Environment:
#   REMOTE      ssh alias. Default: vps
#   HEALTH_URL  public endpoint to probe.
#               Default: https://cloud.kaisho.dev/healthz
set -euo pipefail

REMOTE="${REMOTE:-vps}"
REMOTE_DIR="${REMOTE_DIR:-/home/docker/kaisho-cloud}"
HEALTH_URL="${HEALTH_URL:-https://cloud.kaisho.dev/healthz}"

fail=0

check() {
    local name="$1"
    local cmd="$2"
    if eval "${cmd}" >/dev/null 2>&1; then
        printf "  ok    %s\n" "${name}"
    else
        printf "  FAIL  %s\n" "${name}"
        fail=1
    fi
}

running() {
    echo "ssh ${REMOTE} 'docker ps -q -f name=^$1\$ \
        -f status=running | grep -q .'"
}

echo "containers:"
check "api running"  "$(running kaisho-cloud)"
check "cron running" "$(running kaisho-cron)"
check "db running"   "$(running kaisho-cloud-db)"

echo "database:"
check "postgres accepting connections" \
    "ssh ${REMOTE} 'docker exec kaisho-cloud-db pg_isready -q'"

echo "endpoint:"
check "${HEALTH_URL} returns ok" \
    "curl -fsS --max-time 10 '${HEALTH_URL}' | grep -q '\"ok\":true'"

# True when the remote log scan produces no output.
#
# The subtlety: an unreachable host also produces no output,
# so a plain emptiness test reports "ok, no fatal errors" for
# a server that is simply gone. Print a sentinel after the
# grep and require it, which separates "scan ran and found
# nothing" from "scan never ran".
log_clean() {
    local container="$1"
    local pattern="$2"
    local out
    out="$(ssh "${REMOTE}" "docker logs --since 15m ${container} \
        2>&1 | grep -iE '${pattern}'; echo __SCAN_OK__")" || return 1
    [[ "${out}" == *"__SCAN_OK__"* ]] || return 1
    [[ "$(echo "${out}" | grep -v '__SCAN_OK__')" == "" ]]
}

echo "log scan (last 15 minutes):"
check "api: no fatal errors"  "log_clean kaisho-cloud 'fatal|panic'"
check "cron: no fatal errors" "log_clean kaisho-cron 'fatal|panic'"

# Honour REMOTE_DIR like bin/deploy does; hardcoding the
# path meant a staging deploy reported production's sha.
echo "deployed revision:"
ssh "${REMOTE}" "cat ${REMOTE_DIR}/.deploy-sha 2>/dev/null" \
    || echo "  (none recorded)"

exit "${fail}"

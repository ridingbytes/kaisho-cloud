#!/usr/bin/env bash
# Health check for the hosted stack on the VPS. Exits
# non-zero if any check fails. Safe to call from cron or an
# uptime monitor.
#
# Usage:
#   bin/health
#
# Environment:
#   REMOTE      ssh alias. Default: vps
#   HEALTH_URL  public endpoint to probe.
#               Default: https://cloud.kaisho.dev/healthz
set -euo pipefail

REMOTE="${REMOTE:-vps}"
HEALTH_URL="${HEALTH_URL:-https://cloud.kaisho.dev/healthz}"

fail=0

check() {
    local name="$1"
    local cmd="$2"
    if eval "${cmd}" >/dev/null 2>&1; then
        printf "  ok    %s\n" "${name}"
    else
        printf "  FAIL  %s\n" "${name}"
        fail=1
    fi
}

running() {
    echo "ssh ${REMOTE} 'docker ps -q -f name=^$1\$ \
        -f status=running | grep -q .'"
}

echo "containers:"
check "api running"  "$(running kaisho-cloud)"
check "cron running" "$(running kaisho-cron)"
check "db running"   "$(running kaisho-cloud-db)"

echo "database:"
check "postgres accepting connections" \
    "ssh ${REMOTE} 'docker exec kaisho-cloud-db pg_isready -q'"

echo "endpoint:"
check "${HEALTH_URL} returns ok" \
    "curl -fsS --max-time 10 '${HEALTH_URL}' | grep -q '\"ok\":true'"

# Helper: true when the remote pipeline produces no output.
# Avoids the "grep on empty input exits 1" trap.
log_clean() {
    local container="$1"
    local pattern="$2"
    [[ -z "$(ssh "${REMOTE}" "docker logs --since 15m ${container} \
        2>&1 | grep -iE '${pattern}'")" ]]
}

echo "log scan (last 15 minutes):"
check "api: no fatal errors"  "log_clean kaisho-cloud 'fatal|panic'"
check "cron: no fatal errors" "log_clean kaisho-cron 'fatal|panic'"

echo "deployed revision:"
ssh "${REMOTE}" "cat /home/docker/kaisho-cloud/.deploy-sha 2>/dev/null" \
    || echo "  (none recorded)"

exit "${fail}"
